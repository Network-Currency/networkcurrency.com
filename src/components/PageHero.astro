---
import Container from './Container.astro';
import HeadlineLines from './HeadlineLines.astro';

interface Props {
  eyebrow?: string;
  headline: string | string[];
  intro?: string;
  size?: 'home' | 'page' | 'person';
}
const { eyebrow, headline, intro, size = 'page' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['hero', 'navy', size]}>
  <Container class="inner">
    <div class:list={['grid', { split: hasAside }]}>
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1><HeadlineLines text={headline} /></h1>
        {intro && <p class="intro">{intro}</p>}
        <slot />
      </div>
      {
        hasAside && (
          <div class="aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
    <slot name="after" />
  </Container>
</section>

<style>
  .hero :global(.inner) {
    padding-top: 88px;
    padding-bottom: 88px;
  }
  .home :global(.inner) {
    padding-top: var(--space-28);
    padding-bottom: var(--space-18);
  }
  .grid.split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-12) var(--space-18);
    align-items: center;
  }
  .eyebrow {
    margin-bottom: var(--space-5);
    font-size: 15px;
    font-weight: 600;
    color: var(--accent-ink);
  }
  .home .eyebrow {
    margin-bottom: var(--space-6);
  }
  h1 {
    max-width: 860px;
    font-size: 56px;
    line-height: 62px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .home h1 {
    max-width: 900px;
    font-size: 72px;
    line-height: 76px;
    letter-spacing: -0.035em;
  }
  .person h1 {
    font-size: 64px;
    line-height: 68px;
    letter-spacing: -0.035em;
  }
  .intro {
    max-width: 700px;
    margin-top: 26px;
    font-size: 19px;
    line-height: 30px;
    color: var(--ink-muted);
  }
  .home .intro {
    max-width: 640px;
    margin-top: 28px;
    font-size: 20px;
    line-height: 31px;
  }
  .aside {
    color: var(--ink-muted);
  }

  @media (max-width: 760px) {
    .hero :global(.inner) {
      padding-top: var(--space-18);
      padding-bottom: var(--space-18);
    }
    .home :global(.inner) {
      padding-top: var(--space-24);
    }
    h1,
    .person h1 {
      font-size: 40px;
      line-height: 44px;
    }
    .home h1 {
      font-size: 44px;
      line-height: 48px;
    }
    h1 {
      --line-gap: var(--space-4);
    }
  }
</style>
