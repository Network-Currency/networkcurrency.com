---
import Chip from './Chip.astro';
import { writingLink, writingKind, formatDate, type Writing } from '../lib/content';

interface Props {
  item: Writing;
  variant?: 'card' | 'featured' | 'row';
  /** Call to action label, from the AI Governance page content. */
  readLabel?: string;
}
const { item, variant = 'card', readLabel } = Astro.props;
const w = item.data;
const { href, external } = writingLink(item);
const kind = writingKind(item);
---

{
  variant === 'row' ? (
    <a class="row" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
      <span class="row-kind">{kind}</span>
      <span class="row-title">{w.title}</span>
    </a>
  ) : (
    <a
      class:list={['card', variant]}
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
    >
      <Chip variant="accent" size="md">{kind}</Chip>
      <span class="title">{w.title}</span>
      <span class="summary keep-breaks">{w.summary}</span>
      <span class="foot">
        {w.date && <span class="date">{formatDate(w.date)}</span>}
        {readLabel && <span class="read">{readLabel}</span>}
      </span>
    </a>
  )
}

<style>
  a {
    text-decoration: none;
    color: var(--ink);
  }
  a:hover {
    color: var(--ink);
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-height: 280px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .card:hover {
    border-color: var(--accent);
  }
  .title {
    font-size: 19px;
    line-height: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .summary {
    font-size: 15px;
    line-height: 23px;
    color: var(--ink-muted);
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    align-self: stretch;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }
  .foot:empty {
    display: none;
  }
  .date {
    color: var(--ink-muted);
  }
  .read {
    margin-left: auto;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .featured {
    min-height: 0;
    padding: var(--space-12);
    gap: var(--space-4);
  }
  .featured .title {
    font-size: 40px;
    line-height: 46px;
    letter-spacing: -0.025em;
  }
  .featured .summary {
    font-size: 17px;
    line-height: 27px;
  }
  .featured .foot {
    align-self: flex-start;
    margin-top: var(--space-2);
    padding-top: 0;
    border-top: 0;
  }
  .featured .read {
    margin-left: 0;
    font-size: 15px;
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 26px 30px;
    border-bottom: 1px solid var(--border);
  }
  .row:hover .row-title {
    color: var(--accent-ink);
  }
  .row-kind {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-muted);
  }
  .row-title {
    font-size: 18px;
    line-height: 25px;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .featured {
      padding: var(--space-8) var(--space-6);
    }
    .featured .title {
      font-size: 30px;
      line-height: 36px;
    }
  }
</style>
