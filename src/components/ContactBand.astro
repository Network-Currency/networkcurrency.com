---
import Container from './Container.astro';
import Button from './Button.astro';
import HeadlineLines from './HeadlineLines.astro';
import Eyebrow from './Eyebrow.astro';
import { getSite } from '../lib/content';

interface Props {
  eyebrow?: string;
  headline: string | string[];
  body: string;
  linkedinLabel?: string;
  id?: string;
}
const { eyebrow, headline, body, linkedinLabel, id } = Astro.props;
const site = await getSite();
---

<Container as="section" id={id} class="pt-xl pb-lg">
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <div class="band accent-band">
    <h2><HeadlineLines text={headline} /></h2>
    <div class="rule"></div>
    <div class="row">
      <p class="body keep-breaks">{body}</p>
      <div class="actions">
        <Button href={`mailto:${site.email}`} variant="on-accent">{site.email}</Button>
        {linkedinLabel && <Button href={site.linkedin} variant="outline">{linkedinLabel}</Button>}
      </div>
    </div>
  </div>
</Container>

<style>
  .band {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 64px 64px 60px;
    border-radius: var(--radius-card);
  }
  h2 {
    font-size: 46px;
    line-height: 56px;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .rule {
    height: 1px;
    background: var(--border);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .body {
    flex: 1 1 360px;
    max-width: 620px;
    font-size: 18px;
    line-height: 27px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 760px) {
    .band {
      gap: var(--space-5);
      padding: var(--space-8) var(--space-6);
    }
    h2 {
      font-size: 28px;
      line-height: 35px;
      --line-gap: var(--space-3);
    }
  }
</style>
