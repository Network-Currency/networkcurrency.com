---
import Container from './Container.astro';
import Button from './Button.astro';
import { getSite } from '../lib/content';

interface Props {
  headline: string;
  body: string;
  linkedinLabel?: string;
  id?: string;
}
const { headline, body, linkedinLabel, id } = Astro.props;
const site = await getSite();
---

<Container as="section" id={id} class="pt-xl pb-lg">
  <div class="band navy">
    <div class="text">
      <h2>{headline}</h2>
      <p>{body}</p>
    </div>
    <div class="actions">
      <Button href={`mailto:${site.email}`} variant="primary">{site.email}</Button>
      {linkedinLabel && <Button href={site.linkedin} variant="on-navy">{linkedinLabel}</Button>}
    </div>
  </div>
</Container>

<style>
  .band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-14);
    border-radius: var(--radius-card);
  }
  .text {
    max-width: 620px;
  }
  h2 {
    font-size: 36px;
    line-height: 42px;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  p {
    margin-top: var(--space-4);
    font-size: 17px;
    line-height: 26px;
    color: var(--ink-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 760px) {
    .band {
      padding: var(--space-8) var(--space-6);
    }
    h2 {
      font-size: 28px;
      line-height: 34px;
    }
  }
</style>
