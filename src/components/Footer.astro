---
import Container from './Container.astro';
import { getSite } from '../lib/content';

const site = await getSite();
---

<footer>
  <Container class="inner">
    <span>{site.footer.copyright}</span>
    <nav class="links" aria-label="Footer">
      {site.footer.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </Container>
</footer>

<style>
  footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    color: var(--ink-muted);
    font-size: 14px;
  }
  footer :global(.inner) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: 28px;
    padding-bottom: 28px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }
  .links a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
