---
interface Props {
  eyebrow?: string;
  headline: string;
}
const { eyebrow, headline } = Astro.props;
---

<div>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="h-section">{headline}</h2>
</div>

<style>
  .eyebrow {
    margin-bottom: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-ink);
  }
</style>
