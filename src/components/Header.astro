---
import Container from './Container.astro';
import Button from './Button.astro';
import { getSite } from '../lib/content';

const site = await getSite();
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="header navy">
  <Container class="bar">
    <a class="brand" href="/">
      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="28" height="28" rx="8" stroke="currentColor" stroke-width="2"></rect>
        <circle cx="10" cy="10" r="2.5" fill="currentColor"></circle>
        <circle cx="20" cy="15" r="2.5" fill="currentColor"></circle>
        <circle cx="10" cy="20" r="2.5" fill="currentColor"></circle>
        <path d="M10 10L20 15L10 20" stroke="currentColor" stroke-width="1.6"></path>
      </svg>
      <span>{site.name}</span>
    </a>

    <nav class="desktop" aria-label="Main">
      {
        site.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <Button href={site.contactCta.href} variant="accent" size="sm">{site.contactCta.label}</Button>
    </nav>

    <details class="mobile">
      <summary aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav class="panel" aria-label="Main">
        {
          site.nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
        <Button href={site.contactCta.href} variant="accent" size="sm">{site.contactCta.label}</Button>
      </nav>
    </details>
  </Container>
</header>

<style>
  .header {
    position: relative;
    border-bottom: 1px solid var(--border);
  }
  .header :global(.bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    height: var(--header-height);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    text-decoration: none;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brand svg {
    color: var(--accent);
  }
  .brand:hover {
    color: var(--ink);
  }
  nav a:not([class]) {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }
  nav a:not([class]):hover,
  nav a[aria-current='page'] {
    color: var(--white);
  }
  .desktop {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }
  .mobile {
    display: none;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding: var(--space-6) var(--gutter) var(--space-8);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 760px) {
    .desktop {
      display: none;
    }
    .mobile {
      display: block;
    }
  }
</style>
