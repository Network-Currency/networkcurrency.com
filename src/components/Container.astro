---
interface Props {
  as?: 'div' | 'section';
  id?: string;
  class?: string;
}
const { as: Tag = 'div', id, class: className } = Astro.props;
---

<Tag id={id} class:list={['container', className]}><slot /></Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }
</style>
