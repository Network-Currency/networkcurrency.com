---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import PageHero from '../components/PageHero.astro';
import Chip from '../components/Chip.astro';
import SectionHead from '../components/SectionHead.astro';
import CaseCard from '../components/CaseCard.astro';
import ContactBand from '../components/ContactBand.astro';
import { render } from 'astro:content';
import { getConsulting, getServices, getCases, getWriting, writingLink } from '../lib/content';

const page = await getConsulting();
const services = await getServices();
const cases = await getCases();
const writing = (await getWriting()).filter((w) => w.data.featured);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout meta={page.meta}>
  <PageHero eyebrow={page.eyebrow} headline={page.headline} intro={page.intro} />

  <Container as="section" class="pt-lg">
    <SectionHead eyebrow={page.services.eyebrow} headline={page.services.headline} />
    <nav class="index" aria-label={page.services.eyebrow}>
      {
        services.map((s, i) => (
          <a href={`#${s.id}`}>
            <span class="num">{pad(i + 1)}</span>
            <span class="name">{s.data.name}</span>
          </a>
        ))
      }
    </nav>

    <div class="services">
      {
        await Promise.all(
          services.map(async (s, i) => {
            const mine = cases.filter((c) => c.data.service === s.data.name);
            const { Content } = await render(s);
            const links = s.data.showWriting ? writing : [];
            return (
              <article id={s.id} class="service">
                <div class="service-top">
                  <div class="service-head">
                    <span class="num">{pad(i + 1)}</span>
                    <h3>{s.data.name}</h3>
                    {links.length > 0 && (
                      <div class="links">
                        {links.map((w) => (
                          <a
                            class="link-row"
                            href={writingLink(w).href}
                            target={writingLink(w).external ? '_blank' : undefined}
                            rel={writingLink(w).external ? 'noopener' : undefined}
                          >
                            <span>{w.data.title}</span>
                            <span class="arrow" aria-hidden="true">
                              →
                            </span>
                          </a>
                        ))}
                        {s.data.writingLinkLabel && (
                          <a class="link-all" href="/ai-governance/">
                            {s.data.writingLinkLabel}
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                  <div class="service-body">
                    <div class="description">
                      <Content />
                    </div>
                    <div>
                      <p class="small-label">{page.engagementsLabel}</p>
                      <div class="chips">
                        {s.data.engagements.map((e) => (
                          <Chip>{e}</Chip>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
                {mine.length > 0 && (
                  <div class="cases">
                    <p class="small-label">{page.casesLabel}</p>
                    <div class="case-grid">
                      {mine.map((c) => (
                        <CaseCard item={c} variant="full" labels={page.caseLabels} />
                      ))}
                    </div>
                  </div>
                )}
              </article>
            );
          }),
        )
      }
    </div>
  </Container>

  {
    page.models.items.length > 0 && (
      <Container as="section" class="pt-xl">
        <SectionHead eyebrow={page.models.eyebrow} headline={page.models.headline} />
        <div class="models">
          {page.models.items.map((m) => (
            <div class="model">
              <h3>{m.name}</h3>
              <p class="keep-breaks">{m.body}</p>
            </div>
          ))}
        </div>
      </Container>
    )
  }

  <ContactBand
    eyebrow={page.contactBand.eyebrow}
    headline={page.contactBand.headline}
    body={page.contactBand.body}
  />
</BaseLayout>

<style>
  .index {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: var(--space-3);
    margin: var(--space-8) 0 var(--space-10);
  }
  .index a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    text-decoration: none;
    color: var(--ink);
  }
  .index a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }
  .index .num {
    font-size: 13px;
  }
  .index .name {
    font-size: 15px;
    line-height: 20px;
    font-weight: 600;
  }
  .num {
    font-size: 15px;
    font-weight: 700;
    color: var(--accent);
  }

  .services {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .service {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding: var(--space-10);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    scroll-margin-top: var(--space-6);
  }
  .service-top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-8) var(--space-14);
  }
  .service-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  h3 {
    font-size: 28px;
    line-height: 34px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .links {
    display: flex;
    flex-direction: column;
    margin-top: 10px;
    border-top: 1px solid var(--border);
  }
  .link-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }
  .link-row:hover {
    color: var(--accent-ink);
  }
  .arrow {
    color: var(--accent-ink);
  }
  .link-all {
    padding-top: 14px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }
  .service-body {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .description {
    font-size: 17px;
    line-height: 28px;
  }
  /* Markdown body: space between consecutive blocks, matching the hosted-page prose (--space-5). */
  .description > :global(* + *) {
    margin-top: var(--space-5);
  }
  .description :global(ul),
  .description :global(ol) {
    padding-left: var(--space-6);
  }
  .small-label {
    margin-bottom: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cases {
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .cases .small-label {
    margin-bottom: var(--space-4);
  }
  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: var(--space-4);
  }

  .models {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: var(--space-5);
    margin-top: var(--space-10);
  }
  .model {
    padding: var(--space-8);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }
  .model h3 {
    margin-bottom: 10px;
    font-size: 20px;
    line-height: 26px;
    letter-spacing: 0;
  }
  .model p {
    font-size: 16px;
    line-height: 25px;
    color: var(--ink-muted);
  }

  @media (max-width: 760px) {
    .service {
      padding: var(--space-6);
    }
  }
</style>
